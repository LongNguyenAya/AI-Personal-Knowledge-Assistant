# Chỉ dùng lúc chạy drizzle-kit (generate/migrate) 
# Không cần lúc chạy app thật
# Thường trùng DATABASE_ADMIN_URL, hoặc dùng connection string superuser (postgres/postgres) nếu
# Drizzle-kit migrate cần quyền tạo role/enable RLS
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5433/ai_knowledge_assistant

# Kết nối Postgres với 2 role riêng, khớp với backend-service/.env.example
DATABASE_APP_URL=postgresql://app_user:app_user_password@localhost:5433/ai_knowledge_assistant
DATABASE_ADMIN_URL=postgresql://admin_user:admin_user_password@localhost:5433/ai_knowledge_assistant

BETTER_AUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên bất kỳ, ví dụ: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Nửa PRIVATE của cặp khoá EdDSA, nửa PUBLIC nằm ở backend-service/.env (JWT_PUBLIC_KEY)
# Sinh cặp khoá: xem README.md mục "Bắt đầu chạy local". KHÔNG chia sẻ giá trị này
JWT_PRIVATE_KEY=

# URL backend-service — dùng ở server (route API của frontend-app tự gọi sang, không lộ ra trình duyệt)
BACKEND_URL=http://localhost:4000

# URL WebSocket của backend-service — biến DUY NHẤT ở đây lộ ra trình duyệt (bắt buộc tiền tố NEXT_PUBLIC_) 
# Đổi sang wss://<domain-EC2-thật> khi lên production
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:4000

# Gmail SMTP chỉ dùng làm proxy gọi sang backend-service gửi email thật (Render chặn SMTP ra ngoài)
# Giá trị phải khớp backend-service/.env.example.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Gemini dùng cho admin dashboard (nhận định AI cho biểu đồ), giá trị giống backend-service
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
