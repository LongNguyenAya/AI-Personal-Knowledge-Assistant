# Kết nối Postgres — 2 role riêng, xem packages/db/src/schema.ts + docker/initdb/01-roles.sql
DATABASE_APP_URL=postgresql://app_user:app_user_password@localhost:5433/ai_knowledge_assistant
DATABASE_ADMIN_URL=postgresql://admin_user:admin_user_password@localhost:5433/ai_knowledge_assistant

# Nửa PUBLIC của cặp khoá EdDSA — nửa PRIVATE nằm ở frontend-app/.env.local (JWT_PRIVATE_KEY).
# Sinh cặp khoá: xem README.md mục "Bắt đầu chạy local".
JWT_PUBLIC_KEY=

# Gemini — cùng 1 API key, dùng qua 3 SDK khác nhau nên cần khai cả 3 biến giống nhau
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — model dùng xác minh trích dẫn (research-node), tách quota khỏi Gemini chính
GROQ_API_KEY=

# Gmail SMTP (qua Nodemailer) — bật "Mật khẩu ứng dụng" (App Password) trong tài khoản Google
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Langfuse — trace mọi lệnh gọi LLM (tạo project miễn phí tại langfuse.com)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# AWS — cần 1 bucket S3 (lưu file upload) + 1 hàng đợi SQS (ingest tài liệu) tạo sẵn trên AWS Console
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SQS_QUEUE_URL=
S3_BUCKET_NAME=

# Tuỳ chọn — thiếu chỉ tắt tính năng tóm tắt tuần, không chặn khởi động service.
# Cần thêm 1 hàng đợi SQS thứ 2 + 1 EventBridge Scheduler bắn theo lịch cron trỏ vào hàng đợi đó.
WEEKLY_DIGEST_QUEUE_URL=
